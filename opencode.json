{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "references": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "rosetta.references"
      ],
      "enabled": true
    }
  },
  "model": "opencode/big-pickle",
  "default_agent": "rosetta-agent",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "agent": {
    "rosetta-agent": {
      "description": "Implement and verify software changes, consulting technical references when useful.",
      "mode": "primary",
      "color": "#ddf95c"
    },
    "rosetta-plan": {
      "description": "Inspect software and references without modifying files.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "rosetta-verify": {
      "description": "Run project checks and report evidence without editing code.",
      "mode": "primary",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
