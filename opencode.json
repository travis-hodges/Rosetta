{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rosetta": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "rosetta.tools"
      ],
      "enabled": true,
      "environment": {
        "PYTHONUNBUFFERED": "1",
        "ROSETTA_TOOLS_BACKEND": "auto"
      }
    }
  },
  "default_agent": "rosetta",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "username": "rosetta",
  "permission": {
    "bash": {
      "git push*": "deny",
      "git commit*": "deny",
      "gh pr *": "deny",
      "docker rm*": "deny",
      "docker stop*": "deny",
      "*": "allow"
    }
  },
  "agent": {
    "rosetta": {
      "description": "Work on obscure languages with the selected model and report executable verification evidence.",
      "mode": "primary",
      "color": "#ff8053",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git push*": "deny",
          "git commit*": "deny",
          "gh pr *": "deny",
          "docker rm*": "deny",
          "docker stop*": "deny",
          "*": "allow"
        },
        "edit": "allow",
        "webfetch": "ask"
      }
    },
    "divergence": {
      "description": "Read a verification report and explain what broke in plain language.",
      "mode": "subagent",
      "color": "#c4deaa",
      "temperature": 0,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "explain": {
      "description": "Read-only explanation of an unfamiliar routine grounded in available evidence.",
      "mode": "subagent",
      "color": "#a1a49a",
      "temperature": 0.1,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "build": {
      "color": "#a1a49a"
    },
    "plan": {
      "color": "#f4f1e9"
    }
  }
}
