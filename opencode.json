{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "references": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "rosetta.references"
      ],
      "enabled": true
    }
  },
  "default_agent": "rosetta",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "agent": {
    "rosetta": {
      "description": "Implement and verify software changes, consulting technical references when useful.",
      "mode": "primary",
      "color": "#ddf95c"
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
