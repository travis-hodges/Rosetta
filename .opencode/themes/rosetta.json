{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "paper": "#EEEEE7",
    "paperMuted": "#E2E4D9",
    "paperDeep": "#D2D7C1",
    "ink": "#242720",
    "inkMuted": "#626759",
    "acid": "#DDF95C",
    "acidSoft": "#D8EE9B",
    "moss": "#748523",
    "mossDeep": "#4B5B24",
    "dark": "#1B1E18",
    "terminal": "#20241D",
    "terminalRaised": "#292E25",
    "terminalLine": "#424A37",
    "terminalMuted": "#AEB79B",
    "alarm": "#F5A18D",
    "alarmDeep": "#A5301B",
    "warning": "#F0CB78",
    "info": "#B8D7E8",
    "violet": "#C7B9E8"
  },
  "theme": {
    "primary": { "dark": "acid", "light": "mossDeep" },
    "secondary": { "dark": "acidSoft", "light": "moss" },
    "accent": { "dark": "paper", "light": "ink" },
    "error": { "dark": "alarm", "light": "alarmDeep" },
    "warning": { "dark": "warning", "light": "#8A5B00" },
    "success": { "dark": "acidSoft", "light": "mossDeep" },
    "info": { "dark": "info", "light": "#315F73" },
    "text": { "dark": "paper", "light": "ink" },
    "textMuted": { "dark": "terminalMuted", "light": "inkMuted" },
    "background": { "dark": "dark", "light": "paper" },
    "backgroundPanel": { "dark": "terminal", "light": "paperMuted" },
    "backgroundElement": { "dark": "terminalRaised", "light": "paperDeep" },
    "border": { "dark": "terminalLine", "light": "#B5BAA6" },
    "borderActive": { "dark": "acid", "light": "mossDeep" },
    "borderSubtle": { "dark": "#343A2F", "light": "#C9CBC0" },
    "diffAdded": { "dark": "acidSoft", "light": "mossDeep" },
    "diffRemoved": { "dark": "alarm", "light": "alarmDeep" },
    "diffContext": { "dark": "terminalMuted", "light": "inkMuted" },
    "diffHunkHeader": { "dark": "info", "light": "#315F73" },
    "diffHighlightAdded": { "dark": "acid", "light": "mossDeep" },
    "diffHighlightRemoved": { "dark": "#FFB6A4", "light": "alarmDeep" },
    "diffAddedBg": { "dark": "#293322", "light": "#DDE5C4" },
    "diffRemovedBg": { "dark": "#38251F", "light": "#ECD5CE" },
    "diffContextBg": { "dark": "terminal", "light": "paperMuted" },
    "diffLineNumber": { "dark": "#77816B", "light": "#8A8F80" },
    "diffAddedLineNumberBg": { "dark": "#334127", "light": "#CFD9AD" },
    "diffRemovedLineNumberBg": { "dark": "#493028", "light": "#DFC2B9" },
    "markdownText": { "dark": "paper", "light": "ink" },
    "markdownHeading": { "dark": "acid", "light": "mossDeep" },
    "markdownLink": { "dark": "info", "light": "#315F73" },
    "markdownLinkText": { "dark": "acidSoft", "light": "mossDeep" },
    "markdownCode": { "dark": "acidSoft", "light": "mossDeep" },
    "markdownBlockQuote": { "dark": "terminalMuted", "light": "inkMuted" },
    "markdownEmph": { "dark": "warning", "light": "#7A5200" },
    "markdownStrong": { "dark": "paper", "light": "ink" },
    "markdownHorizontalRule": { "dark": "terminalLine", "light": "#B5BAA6" },
    "markdownListItem": { "dark": "acid", "light": "mossDeep" },
    "markdownListEnumeration": { "dark": "acidSoft", "light": "moss" },
    "markdownImage": { "dark": "info", "light": "#315F73" },
    "markdownImageText": { "dark": "terminalMuted", "light": "inkMuted" },
    "markdownCodeBlock": { "dark": "paper", "light": "ink" },
    "syntaxComment": { "dark": "#7F8972", "light": "#757B6D" },
    "syntaxKeyword": { "dark": "info", "light": "#315F73" },
    "syntaxFunction": { "dark": "acid", "light": "mossDeep" },
    "syntaxVariable": { "dark": "paper", "light": "ink" },
    "syntaxString": { "dark": "acidSoft", "light": "mossDeep" },
    "syntaxNumber": { "dark": "violet", "light": "#66528A" },
    "syntaxType": { "dark": "warning", "light": "#7A5200" },
    "syntaxOperator": { "dark": "info", "light": "#315F73" },
    "syntaxPunctuation": { "dark": "terminalMuted", "light": "inkMuted" }
  }
}
