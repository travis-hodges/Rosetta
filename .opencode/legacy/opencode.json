{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rosetta": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "rosetta.tools"
      ],
      "enabled": true,
      "environment": {
        "PYTHONUNBUFFERED": "1",
        "ROSETTA_TOOLS_BACKEND": "auto"
      }
    }
  },
  "model": "opencode/big-pickle",
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "name": "Translator 1.0"
        }
      }
    }
  },
  "default_agent": "rosetta-agent",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "username": "rosetta",
  "permission": {
    "bash": {
      "git push*": "deny",
      "git commit*": "deny",
      "gh pr *": "deny",
      "docker rm*": "deny",
      "docker stop*": "deny",
      "*": "allow"
    }
  },
  "agent": {
    "rosetta-agent": {
      "description": "Rosetta Agent mode: understand, modify, and mechanically verify VA VistA MUMPS.",
      "mode": "primary",
      "color": "#ff8053",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git push*": "deny",
          "git commit*": "deny",
          "gh pr *": "deny",
          "docker rm*": "deny",
          "docker stop*": "deny",
          "*": "allow"
        },
        "edit": "allow",
        "webfetch": "ask"
      }
    },
    "rosetta-plan": {
      "description": "Rosetta Plan mode: map unfamiliar MUMPS routines and globals before editing.",
      "mode": "primary",
      "color": "#f4f1e9",
      "temperature": 0.1,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "rosetta-verify": {
      "description": "Rosetta Verify mode: prove a candidate against executable behavior and database state.",
      "mode": "primary",
      "color": "#ddf95c",
      "temperature": 0,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "rosetta-divergence": {
      "description": "Explain a Rosetta verification divergence in plain language.",
      "mode": "subagent",
      "color": "#c4deaa",
      "temperature": 0,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "rosetta-explain": {
      "description": "Explain an unfamiliar VistA routine using Rosetta's static and FileMan evidence.",
      "mode": "subagent",
      "color": "#a1a49a",
      "temperature": 0.1,
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
