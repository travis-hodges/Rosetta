{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rosetta-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.mjs",
        "--port",
        "5173"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "rosetta-gui",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "rosetta.gui",
        "--port",
        "7391",
        "--no-open"
      ],
      "port": 7391
    }
  ]
}
